# HydroCast Environment Configuration
# Copy this file to .env and configure your local or cloud environment

# Weather Refresh Interval (in minutes)
WEATHER_REFRESH_MINUTES=15

# Firebase Firestore Configuration
# For Render / Cloud deployments: paste the entire service account JSON string here
FIREBASE_SERVICE_ACCOUNT_JSON=

# For Local development: path to the local service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\vijay\secrets\firebase-key.json

# Google Cloud / Firebase Project ID
FIREBASE_PROJECT_ID=hydra-1963e

# Target Firestore collection for weather snapshots (default: weather_snapshots)
FIRESTORE_WEATHER_COLLECTION=weather_snapshots

# Server Configuration
HOST=0.0.0.0
PORT=8000

